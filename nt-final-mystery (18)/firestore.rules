rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /participants/{participantId} {
      allow create: if isValidParticipant(request.resource.data);
      allow read: if true;
      allow delete: if true;
    }
  }
}

function isValidParticipant(data) {
  return data.keys().hasAll(['firstName', 'lastName', 'email', 'phone', 'birthDate', 'createdAt'])
    && data.keys().size() == 6
    && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100
    && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100
    && data.email is string && data.email.size() > 0 && data.email.size() <= 150
    && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50
    && data.birthDate is string && data.birthDate.size() > 0 && data.birthDate.size() <= 50
    && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 100;
}
